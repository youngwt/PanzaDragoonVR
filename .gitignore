# Original game disc images: copyrighted, never commit
/rom/
# Anything extracted or decoded from the disc: copyrighted, never commit
/extracted/
__pycache__/
# Local emulator install, with firmware links and save states
/tools/mednafen/
# Workflow snapshots generated by BMad on each build run
/_bmad/render/
# Godot's import cache, build output and Android build template: all generated
/game/.godot/
/game/build/*
# ...but keep the marker that stops Godot importing and packing anything saved there
!/game/build/.gdignore
/game/android/
*.apk
# Unit test build output
/tests/**/bin/
/tests/**/obj/
# Build output of the decoding library and the PC command
/lib/**/bin/
/lib/**/obj/
/tools/pdz-extract/bin/
/tools/pdz-extract/obj/
# The Godot OpenXR vendors plugin: 48 MB, installed by tools/setup-toolchain.sh
/game/addons/godotopenxrvendors/
