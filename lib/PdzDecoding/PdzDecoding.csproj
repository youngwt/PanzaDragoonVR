<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Saturn decoding library: everything the game and the PC command know about the disc.
       It uses no Godot types. net9.0 is for the APK (Godot 4.7.2's Android templates need it),
       net10.0 for the desktop game, the PC command and the tests. -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>PdzDecoding</RootNamespace>
    <AssemblyName>PdzDecoding</AssemblyName>
    <Version>0.2.0</Version>
    <IsPackable>false</IsPackable>
    <!-- No machine paths or build times in the DLL, so the APK's copy and the PC's are reproducible. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
